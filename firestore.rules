rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function listData(listId) {
      return get(/databases/$(database)/documents/lists/$(listId)).data;
    }

    function isMember(listId) {
      return isSignedIn() && request.auth.uid in listData(listId).memberIds;
    }

    match /lists/{listId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow update: if isSignedIn()
        && ((request.auth.uid in resource.data.memberIds && request.resource.data.ownerId == resource.data.ownerId)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
          && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()) == [request.auth.uid].toSet()
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]))
      );

      match /tasks/{taskId} {
        allow read, write: if isMember(listId);
      }
    }

    match /{path=**}/tasks/{taskId} {
      allow read: if isSignedIn() && resource.data.assigneeId == request.auth.uid;
    }

    match /invites/{code} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && getAfter(/databases/$(database)/documents/lists/$(request.resource.data.listId)).data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && listData(resource.data.listId).ownerId == request.auth.uid;
    }
  }
}
